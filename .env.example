# ===========================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and adjust values
# This file is used by docker-compose.yml

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=artistdb
DB_USER=postgres
DB_PASSWORD=postgres

# MinIO Configuration
MINIO_URL=http://minio:9000
MINIO_EXTERNAL_URL=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=album-covers

# JWT Configuration
# IMPORTANT: Change this in production! Minimum 256 bits required
JWT_SECRET=your-super-secret-key-change-in-production-minimum-256-bits-required-for-jwt-token-generation

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:4200

# Spring Profile
SPRING_PROFILES_ACTIVE=docker
